# Public frontend configuration. Leave empty for the independent local demo.
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BASE_PATH=/wablind/

# SERVER ONLY. Never use a VITE_ prefix for administrative credentials.
PORT=3001
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Exact domains only; empty means remote capture is disabled.
ALLOWED_CAPTURE_HOSTS=
